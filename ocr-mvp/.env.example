# Copy to .env and fill in. Docker Compose reads this file automatically.
# Shells do not export UID/GID by default, so set them here:
#   id -u   -> UID
#   id -g   -> GID
UID=1000
GID=1000
# Groq API key for the receipt structuring step (/parse)
GROQ_API_KEY=<key>
# Optional: override the Groq model (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant
# Optional PostgreSQL settings (defaults: splitty / splitty / splitty, port 5432).
# Change the password before using anything beyond local development.
# POSTGRES_USER=splitty
# POSTGRES_PASSWORD=splitty
# POSTGRES_DB=splitty
# POSTGRES_PORT=5432